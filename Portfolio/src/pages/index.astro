---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Marquee from "../components/Marquee.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { site, capabilities } from "../data/site";
import { projects } from "../data/projects";
---

<Base>
  <span id="top"></span>
  <Nav />

  <main class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- ============================ HERO ============================ -->
    <section class="grid gap-8 py-14 sm:py-20 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-8">
        <p class="mb-4 flex items-center gap-2 text-xs font-bold">
          <span class="border-2 border-ink bg-acid px-2 py-0.5">PORTFOLIO</span>
          <span class="text-ink-soft">/ {site.location}</span>
        </p>

        <h1
          class="font-display text-5xl leading-[0.92] font-bold tracking-tighter sm:text-7xl lg:text-8xl"
        >
          {site.name}<span class="text-signal">.</span><br />
          <span class="text-ink-soft">{site.role}</span>
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed sm:text-lg">
          {site.tagline}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#work"
            class="press border-2 border-ink bg-ink px-5 py-3 text-sm font-bold text-paper shadow-brutal hover:bg-acid hover:text-ink"
          >
            VIEW WORK →
          </a>
          <a
            href="#contact"
            class="press border-2 border-ink bg-paper px-5 py-3 text-sm font-bold shadow-brutal hover:bg-acid"
          >
            CONTACT
          </a>
        </div>
      </div>

      <!-- Spec card -->
      <aside class="lg:col-span-4">
        <div class="border-2 border-ink bg-paper-2 shadow-brutal">
          <div class="border-b-2 border-ink bg-ink px-4 py-2 text-xs font-bold text-paper">
            ./SPEC
          </div>
          <dl class="divide-y-2 divide-ink text-sm">
            <div class="flex justify-between px-4 py-3">
              <dt class="font-bold text-ink-soft">ROLE</dt>
              <dd class="text-right font-bold">{site.role}</dd>
            </div>
            <div class="flex justify-between px-4 py-3">
              <dt class="font-bold text-ink-soft">STATUS</dt>
              <dd class="text-right font-bold text-signal">{site.status}</dd>
            </div>
            <div class="flex justify-between px-4 py-3">
              <dt class="font-bold text-ink-soft">BASED</dt>
              <dd class="text-right font-bold">{site.location}</dd>
            </div>
            <div class="flex justify-between px-4 py-3">
              <dt class="font-bold text-ink-soft">EMAIL</dt>
              <dd class="text-right font-bold break-all">{site.email}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </section>
  </main>

  <Marquee />

  <main class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- ============================ STACK / CAPABILITIES ============================ -->
    <section id="stack" class="scroll-mt-20 py-16 sm:py-24">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
          WHAT I DO
        </h2>
        <span class="text-xs font-bold text-ink-soft">[ 01 ]</span>
      </div>

      <div class="grid gap-px border-2 border-ink bg-ink sm:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((c) => (
            <div class="flex flex-col gap-3 bg-paper p-6 transition-colors hover:bg-acid">
              <span class="font-mono text-sm font-bold text-ink-soft">
                {c.no}
              </span>
              <h3 class="font-display text-xl font-bold tracking-tight">
                {c.title}
              </h3>
              <p class="text-sm leading-relaxed text-ink-soft">{c.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============================ WORK ============================ -->
    <section id="work" class="scroll-mt-20 py-16 sm:py-24">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
          SELECTED WORK
        </h2>
        <span class="text-xs font-bold text-ink-soft">[ 02 ]</span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <!-- ============================ ABOUT ============================ -->
    <section id="about" class="scroll-mt-20 py-16 sm:py-24">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
          ABOUT
        </h2>
        <span class="text-xs font-bold text-ink-soft">[ 03 ]</span>
      </div>

      <div class="grid gap-6 lg:grid-cols-12">
        <p
          class="font-display text-2xl leading-snug font-medium tracking-tight sm:text-3xl lg:col-span-8"
        >
          {site.intro}
        </p>
        <div class="lg:col-span-4">
          <div class="border-2 border-ink bg-acid p-6 shadow-brutal">
            <p class="text-sm leading-relaxed font-bold">
              Polymath by default. I move between disciplines on purpose — the
              best ideas live in the overlap.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================ CONTACT ============================ -->
    <section id="contact" class="scroll-mt-20 pt-16 pb-24 sm:pt-24">
      <div
        class="border-2 border-ink bg-paper-2 p-8 shadow-brutal-lg sm:p-14"
      >
        <p class="text-xs font-bold text-ink-soft">[ 04 ] — CONTACT</p>
        <h2
          class="mt-3 font-display text-4xl leading-[0.95] font-bold tracking-tighter sm:text-6xl lg:text-7xl"
        >
          LET'S BUILD<br />SOMETHING<span class="text-signal">.</span>
        </h2>
        <a
          href={`mailto:${site.email}`}
          class="press mt-8 inline-block border-2 border-ink bg-ink px-6 py-4 text-sm font-bold text-paper shadow-brutal hover:bg-acid hover:text-ink sm:text-base"
        >
          {site.email} →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

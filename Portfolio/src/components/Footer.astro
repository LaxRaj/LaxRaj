---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t-2 border-ink bg-ink text-paper">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          {site.name}
        </p>
        <p class="mt-2 text-sm text-paper/70">{site.role}</p>
        <p class="mt-1 text-xs text-paper/50">{site.location}</p>
      </div>

      <ul class="flex flex-wrap gap-2">
        {
          site.socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="press inline-block border-2 border-paper px-3 py-1.5 text-xs font-bold hover:bg-acid hover:text-ink hover:border-acid"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t-2 border-paper/20 pt-6 text-[11px] text-paper/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {year} {site.name}. ALL RIGHTS RESERVED.</span>
      <span>BUILT WITH ASTRO + TAILWIND — BEAUTIFULLY BRUTAL.</span>
    </div>
  </div>
</footer>
